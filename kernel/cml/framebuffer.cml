(* Framebuffer information *)
structure Framebuffer = struct
    datatype color_mask = Mask int int

    (* Virtual address, width and height in pixels, pitch in bytes per row, bits
       per pixel, Limine memory model, and red, green and blue masks *)
    datatype framebuffer =
        Framebuffer int int int int int int color_mask color_mask color_mask

    fun address (Framebuffer a _ _ _ _ _ _ _ _) = a
    fun width (Framebuffer _ w _ _ _ _ _ _ _) = w
    fun height (Framebuffer _ _ h _ _ _ _ _ _) = h
    fun pitch (Framebuffer _ _ _ p _ _ _ _ _) = p
    fun bpp (Framebuffer _ _ _ _ b _ _ _ _) = b
    fun memory_model (Framebuffer _ _ _ _ _ m _ _ _) = m
    fun red_mask (Framebuffer _ _ _ _ _ _ r _ _) = r
    fun green_mask (Framebuffer _ _ _ _ _ _ _ g _) = g
    fun blue_mask (Framebuffer _ _ _ _ _ _ _ _ b) = b

    (* List of all framebuffers *)
    val framebuffers : framebuffer list =
        let
            val len = Bytes.call_field (fn b => #(n_framebuffers) "" b) 0
            fun load_framebuffer (i : int) =
                case Bytes.call_fields (fn b => #(load_framebuffer) "" b) [i] 12 of
                  [addr, w, h, p, bpp, model, rs, rsh, gs, gsh, bs, bsh] =>
                    Framebuffer addr w h p bpp model (Mask rs rsh) (Mask gs gsh) (Mask bs bsh)
                | _ => Log.fatal Log.Rc_Init_Error "load_framebuffer: wrong field count"
            fun load_framebuffers (i : int) =
                if i >= len then []
                else
                    let
                        val fb = load_framebuffer i
                    in
                    fb :: load_framebuffers (i + 1)
                    end
        in
        load_framebuffers 0
        end

    val primary_fb =
        case framebuffers of
          [] => Log.fatal Log.Rc_Init_Error "primary_fb found no framebuffers"
        | h :: _ => h

    fun scroll_fb (f : framebuffer) (h : int) =
        #(scroll_framebuffer) "" (Bytes.buf_of_fields [address f, h] 2)

    (* Clear the w x h area of the primary framebuffer at (x, y) *)
    fun clear_area (x : int) (y : int) (w : int) (h : int) =
        #(clear_framebuffer_area) ""
            (Bytes.buf_of_fields [address primary_fb, x, y, w, h] 5)

    (* Fill the w x h area of the primary framebuffer at (x, y) *)
    fun fill_area (x : int) (y : int) (w : int) (h : int) =
        #(fill_framebuffer_area) ""
            (Bytes.buf_of_fields [address primary_fb, x, y, w, h] 5)

    fun clear_screen () =
        scroll_fb primary_fb (height primary_fb)
end
