(* Byte sequence operations *)
structure Bytes = struct
    val empty_buf = Word8Array.array 0 (Word8.fromInt 0)

    val int64_max = 9223372036854775807
    val int64_min = ~9223372036854775808

    fun clamp_int64 (n : int) =
        if n > int64_max then int64_max
        else if n < int64_min then int64_min
        else n

    val uint64_modulus = 18446744073709551616

    val size_of_int64_buf = 8
    val size_of_uint64_buf = 8

    (* Encode n as 8 bytes of little-endian unsigned *)
    fun buf_of_uint64 (n : int) =
        let
            val arr = Word8Array.array size_of_int64_buf (Word8.fromInt 0)
            fun fill i v =
                if i = size_of_int64_buf then arr
                else (Word8Array.update arr i (Word8.fromInt (v mod 256)); fill (i + 1) (v div 256))
        in
        fill 0 (n mod uint64_modulus)
        end

    (* Decode the 8 bytes of arr starting at off as a little-endian unsigned
       64-bit integer *)
    fun uint64_of_buf_at (arr : byte_array) (off : int) =
        let
            (* Read the most significant bytes first *)
            fun go i acc =
                if i < 0 then acc
                else go (i - 1) (acc * 256 + Word8.toInt (Word8Array.sub arr (off + i)))
        in
        go (size_of_int64_buf - 1) 0
        end

    (* Decode the first 8 bytes of arr as a little-endian unsigned 64-bit integer *)
    fun uint64_of_buf (arr : byte_array) = uint64_of_buf_at arr 0

    (* Clamp and encode n as 8 bytes of little-endian two's complement *)
    fun buf_of_int64 (n : int) = buf_of_uint64 (clamp_int64 n)

    (* Decode the first 8 bytes of arr as a little-endian two's complement signed
       64-bit integer *)
    fun int64_of_buf (arr : byte_array) =
        let
            val unsigned = uint64_of_buf arr
        in
        (* Values with the top bit set are negative in two's complement *)
        if unsigned > int64_max then unsigned - uint64_modulus else unsigned
        end

    (* Append two Word8Arrays *)
    fun append_w8 (a1 : byte_array) (a2 : byte_array) =
        let
            val arr = Word8Array.array (Word8Array.length a1 + Word8Array.length a2) (Word8.fromInt 0)
        in
        Word8Array.copy a1 0 (Word8Array.length a1) arr 0;
        Word8Array.copy a2 0 (Word8Array.length a2) arr (Word8Array.length a1);
        arr
        end

    (* A buffer of [n] 8-byte fields whose first fields hold [inputs] and whose
       remaining fields are zero *)
    fun buf_of_fields (inputs : int list) (n : int) =
        let
            val arr = Word8Array.array (n * size_of_uint64_buf) (Word8.fromInt 0)
            fun fill (xs : int list) (k : int) =
                case xs of
                  [] => arr
                | x :: rest =>
                    (Word8Array.copy (buf_of_uint64 x) 0 size_of_uint64_buf arr (k * size_of_uint64_buf);
                     fill rest (k + 1))
        in
        fill inputs 0
        end

    (* Call FFI [f] on a buffer of [n] 8-byte fields whose first fields hold
       [inputs], and return all n fields after the call *)
    fun call_fields (f : byte_array -> unit) (inputs : int list) (n : int) =
        let
            val buf = buf_of_fields inputs n
        in
        f buf;
        List.tabulate n (fn k => uint64_of_buf_at buf (k * size_of_uint64_buf))
        end

    (* Call FFI [f] on a single 8-byte field holding [input], and return that
       field after the call *)
    fun call_field (f : byte_array -> unit) (input : int) =
        let
            val buf = buf_of_uint64 input
        in
        f buf;
        uint64_of_buf buf
        end

    fun int_list_of_w8_array_aux (arr : byte_array) (idx : int) =
        if idx = Word8Array.length arr then
            []
        else
            Word8.toInt (Word8Array.sub arr idx) :: int_list_of_w8_array_aux arr (idx + 1)

    fun int_list_of_w8_array (arr : byte_array) = int_list_of_w8_array_aux arr 0
end
