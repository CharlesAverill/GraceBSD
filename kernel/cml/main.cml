fun main () =
    let
        fun factorial n =
            if n = 0 then 1 else n * factorial (n - 1)
        val _ = Serial.write "What's your name? "
        val name = Serial.readn 10
    in
        Serial.writeln ("Hello, " ^ name);
        Serial.write_int 15;
        Serial.write "! = ";
        Serial.write_int (factorial 15);
        Serial.writeln ""
    end;

val _ = main ()
    handle _ => Log.fatal Log.Rc_Error "uncaught exception";
