fun dispatch (job_id : int) =
    case job_id of
      0 => Console.run ()
    | _ => Log.fatal Log.Rc_Error ("job_id out of range: " ^ Int.toString job_id)

val job_id_buf = Bytes.buf_of_uint64 0
val _ = #(job_id) "" job_id_buf
val _ = dispatch (Bytes.uint64_of_buf job_id_buf)
    handle _ => Log.fatal Log.Rc_Error "uncaught exception";
