(* Hardware interrupt events *)
structure Events = struct
    datatype event_type = Timer | Keyboard | Serial
    type event_data = int

    type event = event_type * event_data

    fun int_of_event_type (e : event_type) =
        case e of
          Timer => 0
        | Keyboard => 1
        | Serial => 2

    fun event_type_of_int (x : int) =
        case x of
          0 => Timer
        | 1 => Keyboard
        | 2 => Serial
        | _ => Log.fatal Log.Rc_Error ("event_type_of_int out of range: " ^ Int.toString x)

    datatype poll_result = PollSuccess | PollFailure

    fun int_of_poll_result (p : poll_result) =
        case p of
          PollSuccess => 0
        | PollFailure => 1

    fun poll_result_of_int (x : int) =
        case x of
          0 => PollSuccess
        | 1 => PollFailure
        | _ => Log.fatal Log.Rc_Error ("poll_result_of_int out of range: " ^ Int.toString x)

    fun event_of_ints (ty : int) (data : int) = (event_type_of_int ty, data)

    fun pop_event () =
        case Bytes.call_fields (fn b => #(pop_event) "" b) [] 3 of
          [succ, ty, data] =>
            (case poll_result_of_int succ of
               PollSuccess => Some (event_of_ints ty data)
             | PollFailure => None)
        | _ => Log.fatal Log.Rc_Error "pop_event: wrong field count"

    fun wait_event () =
        case Bytes.call_fields (fn b => #(wait_event) "" b) [] 2 of
          [ty, data] => event_of_ints ty data
        | _ => Log.fatal Log.Rc_Error "wait_event: wrong field count"
end
