(* Keyboard handling - see https://github.com/mit-pdos/xv6-public/blob/master/kbd.c *)
structure Kbd = struct
    datatype key =
          Key char
        | Enter
        | Backspace
        | Up
        | Down
        | Left
        | Right

    fun string_of_key (k : key) =
        case k of
          Key c => String.str c
        | Enter => "\n"
        | _ => ""

    fun lsl x y = Word8.toInt (Word8.<< (Word8.fromInt x) y)

    val no = 0
    val shift = lsl 1 0
    val ctl = lsl 1 1
    val alt = lsl 1 2
    val capslock = lsl 1 3
    val numlock = lsl 1 4
    val scrollock = lsl 1 5
    val esc = lsl 1 6
    val home = 0xe0
    val end_key = 0xe1
    val up = 0xe2
    val down = 0xe3
    val left = 0xe4
    val right = 0xe5
    val pgup = 0xe6
    val pgdown = 0xe7
    val ins = 0xe8
    val del = 0xe9

    fun control x = x - Char.ord #"@"

    fun shiftcode (x : int) =
        case x of
          0x1D => ctl
        | 0x2A => shift
        | 0x36 => shift
        | 0x38 => alt
        | 0x9D => ctl
        | 0xB8 => alt
        | _    => no

    fun togglecode (x : int) =
        case x of
          0x3A => capslock
        | 0x45 => numlock
        | 0x46 => scrollock
        | _    => no

    fun ch c = Char.ord c

    val normalmap = Vector.fromList [
        no, 0x1B, ch #"1", ch #"2", ch #"3", ch #"4", ch #"5", ch #"6", (* 0x00 *)
        ch #"7", ch #"8", ch #"9", ch #"0", ch #"-", ch #"=", 0x08, 0x09, (* 0x08 *)
        ch #"q", ch #"w", ch #"e", ch #"r", ch #"t", ch #"y", ch #"u", ch #"i", (* 0x10 *)
        ch #"o", ch #"p", ch #"[", ch #"]", 0x0A, no, ch #"a", ch #"s", (* 0x18 *)
        ch #"d", ch #"f", ch #"g", ch #"h", ch #"j", ch #"k", ch #"l", ch #";", (* 0x20 *)
        ch #"'", ch #"`", no, ch #"\\", ch #"z", ch #"x", ch #"c", ch #"v", (* 0x28 *)
        ch #"b", ch #"n", ch #"m", ch #",", ch #".", ch #"/", no, ch #"*", (* 0x30 *)
        no, ch #" ", no, no, no, no, no, no, (* 0x38 *)
        no, no, no, no, no, no, no, ch #"7", (* 0x40 *)
        ch #"8", ch #"9", ch #"-", ch #"4", ch #"5", ch #"6", ch #"+", ch #"1", (* 0x48 *)
        ch #"2", ch #"3", ch #"0", ch #".", no, no, no, no, (* 0x50 *)
        no, no, no, no, no, no, no, no, (* 0x58 *)
        no, no, no, no, no, no, no, no, (* 0x60 *)
        no, no, no, no, no, no, no, no, (* 0x68 *)
        no, no, no, no, no, no, no, no, (* 0x70 *)
        no, no, no, no, no, no, no, no, (* 0x78 *)
        no, no, no, no, no, no, no, no, (* 0x80 *)
        no, no, no, no, no, no, no, no, (* 0x88 *)
        no, no, no, no, no, no, no, home, (* 0x90 *)
        no, no, no, no, 0x0A, no, no, no, (* 0x98 *)
        no, no, no, no, no, no, no, no, (* 0xA0 *)
        no, no, no, no, no, no, no, no, (* 0xA8 *)
        no, no, no, no, no, ch #"/", no, no, (* 0xB0 *)
        no, no, no, no, no, no, no, no, (* 0xB8 *)
        no, no, no, no, no, no, no, no, (* 0xC0 *)
        up, pgup, no, left, no, right, no, end_key, (* 0xC8 *)
        down, pgdown, ins, del, no, no, no, no, (* 0xD0 *)
        no, no, no, no, no, no, no, no, (* 0xD8 *)
        no, no, no, no, no, no, no, no, (* 0xE0 *)
        no, no, no, no, no, no, no, no, (* 0xE8 *)
        no, no, no, no, no, no, no, no, (* 0xF0 *)
        no, no, no, no, no, no, no, no (* 0xF8 *)
    ]

    val shiftmap = Vector.fromList [
        no, 0x1B, ch #"!", ch #"@", ch #"#", ch #"$", ch #"%", ch #"^", (* 0x00 *)
        ch #"&", ch #"*", ch #"(", ch #")", ch #"_", ch #"+", 0x08, 0x09, (* 0x08 *)
        ch #"Q", ch #"W", ch #"E", ch #"R", ch #"T", ch #"Y", ch #"U", ch #"I", (* 0x10 *)
        ch #"O", ch #"P", ch #"{", ch #"}", 0x0A, no, ch #"A", ch #"S", (* 0x18 *)
        ch #"D", ch #"F", ch #"G", ch #"H", ch #"J", ch #"K", ch #"L", ch #":", (* 0x20 *)
        ch #"\"", ch #"~", no, ch #"|", ch #"Z", ch #"X", ch #"C", ch #"V", (* 0x28 *)
        ch #"B", ch #"N", ch #"M", ch #"<", ch #">", ch #"?", no, ch #"*", (* 0x30 *)
        no, ch #" ", no, no, no, no, no, no, (* 0x38 *)
        no, no, no, no, no, no, no, ch #"7", (* 0x40 *)
        ch #"8", ch #"9", ch #"-", ch #"4", ch #"5", ch #"6", ch #"+", ch #"1", (* 0x48 *)
        ch #"2", ch #"3", ch #"0", ch #".", no, no, no, no, (* 0x50 *)
        no, no, no, no, no, no, no, no, (* 0x58 *)
        no, no, no, no, no, no, no, no, (* 0x60 *)
        no, no, no, no, no, no, no, no, (* 0x68 *)
        no, no, no, no, no, no, no, no, (* 0x70 *)
        no, no, no, no, no, no, no, no, (* 0x78 *)
        no, no, no, no, no, no, no, no, (* 0x80 *)
        no, no, no, no, no, no, no, no, (* 0x88 *)
        no, no, no, no, no, no, no, home, (* 0x90 *)
        no, no, no, no, 0x0A, no, no, no, (* 0x98 *)
        no, no, no, no, no, no, no, no, (* 0xA0 *)
        no, no, no, no, no, no, no, no, (* 0xA8 *)
        no, no, no, no, no, ch #"/", no, no, (* 0xB0 *)
        no, no, no, no, no, no, no, no, (* 0xB8 *)
        no, no, no, no, no, no, no, no, (* 0xC0 *)
        up, pgup, no, left, no, right, no, end_key, (* 0xC8 *)
        down, pgdown, ins, del, no, no, no, no, (* 0xD0 *)
        no, no, no, no, no, no, no, no, (* 0xD8 *)
        no, no, no, no, no, no, no, no, (* 0xE0 *)
        no, no, no, no, no, no, no, no, (* 0xE8 *)
        no, no, no, no, no, no, no, no, (* 0xF0 *)
        no, no, no, no, no, no, no, no (* 0xF8 *)
    ]

    val ctlmap = Vector.fromList [
        no, no, no, no, no, no, no, no, (* 0x00 *)
        no, no, no, no, no, no, no, no, (* 0x08 *)
        control (ch #"Q"), control (ch #"W"), control (ch #"E"), control (ch #"R"), control (ch #"T"), control (ch #"Y"), control (ch #"U"), control (ch #"I"), (* 0x10 *)
        control (ch #"O"), control (ch #"P"), no, no, 0x0D, no, control (ch #"A"), control (ch #"S"), (* 0x18 *)
        control (ch #"D"), control (ch #"F"), control (ch #"G"), control (ch #"H"), control (ch #"J"), control (ch #"K"), control (ch #"L"), no, (* 0x20 *)
        no, no, no, control (ch #"\\"), control (ch #"Z"), control (ch #"X"), control (ch #"C"), control (ch #"V"), (* 0x28 *)
        control (ch #"B"), control (ch #"N"), control (ch #"M"), no, no, control (ch #"/"), no, no, (* 0x30 *)
        no, no, no, no, no, no, no, no, (* 0x38 *)
        no, no, no, no, no, no, no, no, (* 0x40 *)
        no, no, no, no, no, no, no, no, (* 0x48 *)
        no, no, no, no, no, no, no, no, (* 0x50 *)
        no, no, no, no, no, no, no, no, (* 0x58 *)
        no, no, no, no, no, no, no, no, (* 0x60 *)
        no, no, no, no, no, no, no, no, (* 0x68 *)
        no, no, no, no, no, no, no, no, (* 0x70 *)
        no, no, no, no, no, no, no, no, (* 0x78 *)
        no, no, no, no, no, no, no, no, (* 0x80 *)
        no, no, no, no, no, no, no, no, (* 0x88 *)
        no, no, no, no, no, no, no, home, (* 0x90 *)
        no, no, no, no, 0x0D, no, no, no, (* 0x98 *)
        no, no, no, no, no, no, no, no, (* 0xA0 *)
        no, no, no, no, no, no, no, no, (* 0xA8 *)
        no, no, no, no, no, control (ch #"/"), no, no, (* 0xB0 *)
        no, no, no, no, no, no, no, no, (* 0xB8 *)
        no, no, no, no, no, no, no, no, (* 0xC0 *)
        up, pgup, no, left, no, right, no, end_key, (* 0xC8 *)
        down, pgdown, ins, del, no, no, no, no, (* 0xD0 *)
        no, no, no, no, no, no, no, no, (* 0xD8 *)
        no, no, no, no, no, no, no, no, (* 0xE0 *)
        no, no, no, no, no, no, no, no, (* 0xE8 *)
        no, no, no, no, no, no, no, no, (* 0xF0 *)
        no, no, no, no, no, no, no, no (* 0xF8 *)
    ]

    (* Bitwise helpers for the modifier state *)
    fun band x y = Word64.toInt (Word64.andb (Word64.fromInt x) (Word64.fromInt y))
    fun bor x y = Word64.toInt (Word64.orb (Word64.fromInt x) (Word64.fromInt y))
    fun bxor x y = Word64.toInt (Word64.xorb (Word64.fromInt x) (Word64.fromInt y))
    fun bclear x m = band x (bxor m 0xFF)

    (* Held modifiers and toggles, plus esc while an 0xE0 prefix is pending *)
    val mods = Ref no

    (* Shift is bit 0 and Ctrl is bit 1, so the low two bits pick the map *)
    fun get_map m =
        case m mod 4 of
          0 => normalmap
        | 1 => shiftmap
        | _ => ctlmap

    (* Port of xv6's kbdgetc. Turns one scancode from a keyboard event into a
       character code, or no for prefixes, releases and modifiers *)
    fun get_code (scancode : int) =
        if scancode = 0xE0 then
            (mods := bor (!mods) esc; no)
        else if band scancode 0x80 <> 0 then
            let
                (* Key released *)
                val data = if band (!mods) esc <> 0 then scancode else band scancode 0x7F
            in
                mods := bclear (!mods) (bor (shiftcode data) esc);
                no
            end
        else
            let
                (* After an 0xE0 prefix, extended keys are stored with the high bit set *)
                val data =
                    if band (!mods) esc <> 0 then
                        (mods := bclear (!mods) esc; bor scancode 0x80)
                    else
                        scancode
                val _ = mods := bor (!mods) (shiftcode data)
                val _ = mods := bxor (!mods) (togglecode data)
                val c = Vector.sub (get_map (!mods)) data
            in
                if band (!mods) capslock = 0 then c
                else if ch #"a" <= c andalso c <= ch #"z" then c + (ch #"A" - ch #"a")
                else if ch #"A" <= c andalso c <= ch #"Z" then c + (ch #"a" - ch #"A")
                else c
            end

    (* Translate a character code into a key, or None for codes the console doesn't use *)
    fun key_of_code (c : int) =
        if c = 0x0A orelse c = 0x0D then Some Enter
        else if c = 0x08 then Some Backspace
        else if c = up then Some Up
        else if c = down then Some Down
        else if c = left then Some Left
        else if c = right then Some Right
        else if 0 < c andalso c < 0x80 then Some (Key (Char.chr c))
        else None

    fun get_key (scancode : int) = key_of_code (get_code scancode)

    (* State of serial decoder *)
    datatype serial_mode =
          Normal
        | AfterCr  (* After a CR *)
        | Escape   (* After an ESC *)
        | Sequence (* Inside an escape sequence *)

    val serial_mode = Ref Normal

    (* Convert a byte from serial into a key, or None for bytes that are part of
       a CRLF pair or escape sequence *)
    fun decode_serial (byte : int) =
        case !serial_mode of
          Escape =>
            if byte = ch #"[" orelse byte = ch #"O" then
                (serial_mode := Sequence; None)
            else
                (serial_mode := Normal; None)
        | Sequence =>
            if 0x40 <= byte andalso byte <= 0x7E then
                (serial_mode := Normal;
                 if byte = ch #"A" then Some Up
                 else if byte = ch #"B" then Some Down
                 else if byte = ch #"C" then Some Right
                 else if byte = ch #"D" then Some Left
                 else None)
            else
                None
        | _ =>
            let
                val after_cr = (!serial_mode = AfterCr)
            in
                serial_mode := Normal;
                if byte = 0x0D then (serial_mode := AfterCr; Some Enter)
                else if byte = 0x0A then (if after_cr then None else Some Enter)
                else if byte = 0x08 orelse byte = 0x7F then Some Backspace
                else if byte = 0x1B then (serial_mode := Escape; None)
                else if 0 < byte andalso byte < 0x80 then Some (Key (Char.chr byte))
                else None
            end
end
