structure Console = struct
    fun factorial n =
        if n = 0 then 1 else n * factorial (n - 1)

    fun print_factorial (arg : string) =
        case Int.fromString arg of
          Some n =>
            if n < 0 then
                Render.println "factorial: n must be non-negative"
            else
                Render.println (Int.toString n ^ "! = " ^ Int.toString (factorial n))
        | None => Render.println ("factorial: not a number: " ^ arg)

    fun pad_right pad_char target_len str =
        let
            val current_len = String.size str
        in
            if current_len >= target_len then
            str
            else
            str ^ String.implode (List.tabulate (target_len - current_len) (fn _ => pad_char))
        end

    fun print_memmap () =
        (Render.println (pad_right #" " 18 "Base Address" ^ " | " ^ pad_right #" " 18 "Length" ^ " | Type");
         Render.println (pad_right #"-" (2 * 18 + 3 * 3 + 20) "");
         List.app (fn (base, length, typ) =>
             Render.println (Hex.padded_hex_str_of_int base 16 ^ " | " ^ Hex.padded_hex_str_of_int length 16 ^ " | " ^ Hw.string_of_mmap_entry_type typ)
         ) Hw.mmap_entries)

    fun print_frames () =
        (Render.println (pad_right #" " 6 "" ^ " | " ^ pad_right #" " 12 "Frames" ^ " | " ^ pad_right #" " 12 "Bytes");
         Render.println (pad_right #"-" (2 * 12 + 2 * 3 + 6) "");
         Render.println (pad_right #" " 6 "Free" ^ " | " ^
                         pad_right #" " 12 (Int.toString (FrameAllocator.n_free_frames ())) ^ " | " ^
                         pad_right #" " 12 (Int.toString (FrameAllocator.n_free_bytes ())));
         Render.println (pad_right #" " 6 "Used" ^ " | " ^
                         pad_right #" " 12 (Int.toString (FrameAllocator.size () - FrameAllocator.n_free_frames ())) ^ " | " ^
                         pad_right #" " 12 (Int.toString (FrameAllocator.size_bytes () - FrameAllocator.n_free_bytes ())));
         Render.println (pad_right #" " 6 "Total" ^ " | " ^
                         pad_right #" " 12 (Int.toString (FrameAllocator.size ())) ^ " | " ^
                         pad_right #" " 12 (Int.toString (FrameAllocator.size_bytes ()))))

    (* Print the entry used at each level to translate [vaddr], then the result *)
    fun pt (vaddr : int) =
        let
            val root = Hw.page_table_root ()
            fun flag (b : bool) (c : string) = if b then c else "-"
            fun row (level : int) (e : Paging.entry) =
                Render.println ("L" ^ Int.toString level ^ " [" ^
                    pad_right #" " 3 (Int.toString (Paging.index_of vaddr level)) ^ "] " ^
                    (if Paging.leaf e then "page  " else "table ") ^
                    Hex.padded_hex_str_of_int (Paging.address e) 16 ^ " " ^
                    flag (Paging.writable e) "w" ^ flag (Paging.user e) "u" ^
                    flag (Paging.executable e) "x" ^ flag (Paging.global e) "g")
            fun aux (level : int) =
                case Paging.walk_stop level root vaddr False of
                  None => Render.println ("L" ^ Int.toString level ^ " [" ^
                              Int.toString (Paging.index_of vaddr level) ^ "] not present")
                | Some (_, e, paddr, size) =>
                    (row level e;
                     if Paging.leaf e then
                         Render.println (Hex.hex_str_of_int vaddr ^ " -> " ^ Hex.hex_str_of_int paddr ^
                             " (" ^ Int.toString (size div 1024) ^ " KiB page)")
                     else aux (level - 1))
        in
            Render.println ("page table at " ^ Hex.padded_hex_str_of_int root 16);
            aux Paging.levels
        end

    fun print_pt (addr : string) =
        case Hex.int_of_str addr of
          Some a => if a < 0 then Render.println "pt: addr must be non-negative" else pt a
        | None => Render.println ("pt: not a number: " ^ addr)

    fun print_mem_read (addr : string) (len : string) =
        case (Hex.int_of_str addr, Hex.int_of_str len) of
          (Some a, Some n) =>
            if a < 0 orelse n < 0 then
                Render.println "read: addr and len must be non-negative"
            else
                Render.println (Hex.hex_string_of_w8_arr (Hw.mem_read a n))
        | (None, _) => Render.println ("read: not a number: " ^ addr)
        | (_, None) => Render.println ("read: not a number: " ^ len)

    (* zero-pad n in decimal *)
    fun pad_int (n : int) (w : int) =
        let
            val s = Int.toString n
        in
            if String.size s >= w then s
            else String.implode (List.tabulate (w - String.size s) (fn _ => #"0")) ^ s
        end

    fun print_uptime () =
        let
            val (ticks, reload, raw_hz) = Hw.uptime ()
            val cs = ticks * reload * 100 div raw_hz
            val secs = cs div 100
        in
            Render.println ("up " ^ Int.toString (secs div 3600) ^ ":" ^
                pad_int (secs div 60 mod 60) 2 ^ ":" ^ pad_int (secs mod 60) 2 ^ "." ^
                pad_int (cs mod 100) 2 ^ " (" ^ Int.toString ticks ^ " ticks)")
        end

    fun print_stats () =
        let
            val (ticks, queued, dropped) = Hw.stats ()
            val rows = [
                ("ticks", ticks),
                ("events queued", queued),
                ("events dropped", dropped)
            ]
        in
            List.app (fn (name, n) =>
                Render.println (pad_right #" " 15 name ^ Int.toString n)
            ) rows
        end

    fun greet (name : string) = Render.println ("Hello, " ^ name ^ "!")

    val commands = [
        ("memmap", "print out the memory map"),
        ("frames", "print frame allocator information"),
        ("read <addr> <len>", "read len bytes from *addr"),
        ("pt <addr>", "translate a virtual address"),
        ("uptime", "time since boot"),
        ("stats", "event and interrupt counters"),
        ("mandelbrot", "render the mandelbrot fractal"),
        ("factorial <n>", "compute n!"),
        ("greet <name>", "get greeted"),
        ("clear", "clear the screen"),
        ("hcf", "halt and catch fire"),
        ("help", "show this message")
    ]

    val max_cmd_len = List.foldl
        (fn (str, _) => fn maxlen => if String.size str > maxlen then String.size str else maxlen)
        0 commands

    fun print_help () =
        List.app (fn (cmd, msg) =>
            Render.println (pad_right #" " max_cmd_len cmd ^ "  " ^ msg)
        ) commands

    fun prompt (s : string) =
        (case String.tokens (fn c => c = #" ") s of
          ["memmap"] => print_memmap ()
        | ["frames"] => print_frames ()
        | ["read", addr, len] => print_mem_read addr len
        | ["pt", addr] => print_pt addr
        | ["uptime"] => print_uptime ()
        | ["stats"] => print_stats ()
        | ["mandelbrot"] => Mandelbrot.render ()
        | ["factorial", arg] => print_factorial arg
        | ["greet", arg] => greet arg
        | ["clear"] => (Framebuffer.clear_screen (); Render.place_cursor 0 0)
        | ["hcf"] => Hw.hcf ()
        | [] => ()
        | _ => print_help ();
        Render.print "> ")

    fun feed (k : Kbd.key option) =
        case k of
          Some key => Tty.input key
        | None => ()

    fun run () =
        let
            fun handle_events (counter : int) =
                case Events.wait_event () of
                  (Events.Timer, data) =>
                    if counter + 1 >= 100 then (
                        Render.toggle_cursor ();
                        handle_events 0
                    ) else
                        handle_events (counter + 1)
                | (Events.Keyboard, scancode) =>
                    (feed (Kbd.get_key scancode);
                     handle_events counter)
                | (Events.Serial, byte) =>
                    (feed (Kbd.decode_serial byte);
                     handle_events counter)
        in
            print_help ();
            Render.print "> ";
            Tty.on_line := prompt;
            handle_events 0
        end
end
