(* Font rendering *)
structure Render = struct
    (* Cursor position (x, y) *)
    datatype cursor = Cursor int int

    fun cx (Cursor x _) = x
    fun cy (Cursor _ y) = y

    (* Reference to the current framebuffer cursor *)
    val fb_cursor = Ref (Cursor 0 0)

    (* Move the cursor to the start of the next line of h-pixel glyphs,
       scrolling the screen up if that line wouldn't fit *)
    fun newline (h : int) =
        let
            val y = cy (!fb_cursor)
        in
        if y + 2 * h > Framebuffer.height Framebuffer.primary_fb then (
            Framebuffer.scroll_fb Framebuffer.primary_fb h;
            fb_cursor := Cursor 0 y
        ) else
            fb_cursor := Cursor 0 (y + h)
        end

    (* Advance the cursor horizontally by a glyph of width w and height h, and
       handle wrap, scrolling, and backspaces *)
    fun advance_cursor (w : int) (h : int) =
        let
            val x = cx (!fb_cursor) + w
            val y = cy (!fb_cursor)
            val fb_w = Framebuffer.width Framebuffer.primary_fb
        in
        if w > 0 andalso x + w > fb_w then
            (* The next glyph wouldn't fit on this line *)
            newline h
        else if x < 0 then
            (* Back past the start of the line: to the last glyph of the
               previous line, or stay at the top-left corner *)
            if y + h < 0 then
                fb_cursor := Cursor 0 0
            else
                fb_cursor := Cursor ((fb_w div (~ w) - 1) * (~ w)) (y + h)
        else
            fb_cursor := Cursor x y
        end

    (* Whether the blinking cursor block is currently drawn in the cursor's slot *)
    val cursor_is_toggled = Ref False

    (* Clear or fill the glyph-sized slot at the cursor *)
    fun clear_slot (f : Font.font) =
        Framebuffer.clear_area (cx (!fb_cursor)) (cy (!fb_cursor)) (Font.width_of_font f) (Font.height_of_font f)

    fun fill_slot (f : Font.font) =
        Framebuffer.fill_area (cx (!fb_cursor)) (cy (!fb_cursor)) (Font.width_of_font f) (Font.height_of_font f)

    (* Redraw the cursor block in its new slot if it's showing *)
    fun show_cursor (f : Font.font) =
        if !cursor_is_toggled then fill_slot f else ()

    (* Draw a glyph into the cursor's slot and advance. The slot is cleared first,
       so the cursor block never stays under a glyph, and the block moves along with
       the cursor *)
    fun draw_char (f : Font.font) (c : char) =
        (clear_slot f;
         (if c = #"\n" then
              newline (Font.height_of_font f)
          else (
              Font.render_glyph f c (cx (!fb_cursor)) (cy (!fb_cursor));
              advance_cursor (Font.width_of_font f) (Font.height_of_font f)
          ));
         show_cursor f)

    (* Clear the cursor's slot, first moving back one glyph if advance is set *)
    fun erase_char (f : Font.font) (advance : bool) =
        let
            val w = Font.width_of_font f
            val h = Font.height_of_font f
        in
        clear_slot f;
        (if advance then advance_cursor (~ w) (~ h) else ());
        clear_slot f;
        show_cursor f
        end

    fun draw_string (f : Font.font) (s : string) =
        List.app (fn c => draw_char f c) (String.explode s)

    (* The font print, println and print_int draw with *)
    val default_font = Font.TS_8x14

    (* Draw a string to the screen and also write it over serial *)
    fun print (s : string) =
        (Serial.write s;
         draw_string default_font s)

    (* Draw a string to the screen and also write it over serial, with a newline *)
    fun println (s : string) = print (s ^ "\n")

    (* Draw an int to the screen and also write it over serial *)
    fun print_int (x : int) =
        print (Int.toString x)

    fun toggle_cursor () =
        (cursor_is_toggled := not (!cursor_is_toggled);
        if !cursor_is_toggled then
            fill_slot default_font
        else
            clear_slot default_font)

    fun place_cursor (x : int) (y : int) =
        fb_cursor := Cursor x y
end
