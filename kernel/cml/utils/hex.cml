(* Printing integers as hex numbers *)
structure Hex = struct
    val digits = "0123456789abcdef"

    fun digits_of (x : int) (w : int) =
        let
            (* acc holds the digits found so far, most significant first *)
            fun go (n : int) (acc : char list) =
                if n = 0 then acc
                else go (n div 16) (String.sub digits (n mod 16) :: acc)

            val ds = if x = 0 then [#"0"] else go x []
            val pad = w - List.length ds
        in
            if pad <= 0 then String.implode ds
            else String.implode (List.tabulate pad (fn _ => #"0") @ ds)
        end

    fun padded_hex_str_of_int (x : int) (w : int) =
        if x < 0 then "-0x" ^ digits_of (~ x) w
        else "0x" ^ digits_of x w

    fun hex_str_of_int (x : int) = padded_hex_str_of_int x 0

    fun hex_string_of_w8_arr (arr : byte_array) =
        String.concatWith " " (List.map (fn x => digits_of x 2) (Bytes.int_list_of_w8_array arr))

    fun digit_value (c : char) =
        let
            val n = Char.ord c
        in
            if n >= Char.ord #"0" andalso n <= Char.ord #"9" then Some (n - Char.ord #"0")
            else if n >= Char.ord #"a" andalso n <= Char.ord #"f" then Some (n - Char.ord #"a" + 10)
            else if n >= Char.ord #"A" andalso n <= Char.ord #"F" then Some (n - Char.ord #"A" + 10)
            else None
        end

    fun int_of_hex_digits (s : string) =
        let
            fun go (cs : char list) (acc : int) =
                case cs of
                  [] => Some acc
                | c :: rest =>
                    (case digit_value c of
                       Some d => go rest (acc * 16 + d)
                     | None => None)
        in
            if String.size s = 0 then None else go (String.explode s) 0
        end

    fun int_of_str (s : string) =
        if String.isPrefix "0x" s orelse String.isPrefix "0X" s then
            int_of_hex_digits (String.extract s 2 None)
        else
            Int.fromString s
end
