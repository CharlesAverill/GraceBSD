(* Hardware primitives *)
structure Hw = struct
    (* Halt and Catch Fire *)
    fun hcf () = #(hcf) "" Bytes.empty_buf

    (* HHDM offset *)
    val hhdm_off =
        let
            val buf = Word8Array.array 8 (Word8.fromInt 0)
        in
        #(get_hhdm) "" buf;
        Bytes.uint64_of_buf buf
        end

    (* Limine memory map types *)
    datatype mmap_entry_type =
          Usable | Reserved | Reclaimable | Nvs | BadMemory | BootloaderReclaimable
        | ExecutableAndModules | Framebuffer | ReservedMapped

    fun mmap_entry_type_of_int (i : int) =
        case i of
          0 => Usable
        | 1 => Reserved
        | 2 => Reclaimable
        | 3 => Nvs
        | 4 => BadMemory
        | 5 => BootloaderReclaimable
        | 6 => ExecutableAndModules
        | 7 => Framebuffer
        | 8 => ReservedMapped
        | _ => Log.fatal Log.Rc_Init_Error "mmap_entry_type_of_int: out of bounds"

    fun string_of_mmap_entry_type (m : mmap_entry_type) =
        case m of
          Usable => "USABLE"
        | Reserved => "RESERVED"
        | Reclaimable => "RECLAIMABLE"
        | Nvs => "NVS"
        | BadMemory => "BAD_MEMORY"
        | BootloaderReclaimable => "BOOTLOADER_RECLAIMABLE"
        | ExecutableAndModules => "EXECUTABLE_AND_MODULES"
        | Framebuffer => "FRAMEBUFFER"
        | ReservedMapped => "RESERVED_MAPPED"

    (* Memory map entry: physical base, length, and Limine type *)
    type mmap_entry = int * int * mmap_entry_type

    (* List of all memory map entries *)
    val mmap_entries : mmap_entry list =
        let
            val lenbuf = Bytes.buf_of_uint64 0
            val _ = #(n_mmap_entries) "" lenbuf
            val len = Bytes.uint64_of_buf lenbuf
            val entrybuf = Word8Array.array (3 * Bytes.size_of_uint64_buf) (Word8.fromInt 0)
            fun field (k : int) = Bytes.uint64_of_buf_at entrybuf (k * Bytes.size_of_uint64_buf)
            fun load_entry (i : int) =
                let
                    val _ = Word8Array.copy (Bytes.buf_of_uint64 i) 0 Bytes.size_of_uint64_buf entrybuf 0
                    val _ = #(load_mmap_entry) "" entrybuf
                in
                (field 0, field 1, mmap_entry_type_of_int (field 2))
                end
            fun load_entries (i : int) =
                if i >= len then []
                else
                    let
                        val entry = load_entry i
                    in
                    entry :: load_entries (i + 1)
                    end
        in
        load_entries 0
        end

    (* Heap address *)
    val addr_heap : int =
        let
            val buf = Bytes.buf_of_uint64 0
        in
        #(cml_heap) "" buf;
        Bytes.uint64_of_buf buf
        end

    (* Physical heap address *)
    val paddr_heap : int = addr_heap - hhdm_off

    (* Stack address *)
    val addr_stack : int =
        let
            val buf = Bytes.buf_of_uint64 0
        in
        #(cml_stack) "" buf;
        Bytes.uint64_of_buf buf
        end

    (* Physical stack address *)
    val paddr_stack : int = addr_stack - hhdm_off

    (* Heap size *)
    val heap_size : int = addr_stack - addr_heap

    (* Stack size *)
    val stack_size : int =
        let
            val buf = Bytes.buf_of_uint64 0
        in
        #(cml_stackend) "" buf;
        Bytes.uint64_of_buf buf - addr_stack
        end

    (* Read [len] bytes from memory address [addr] *)
    fun mem_read (addr : int) (len : int) =
        let
            val buf = Bytes.append_w8 (Bytes.buf_of_uint64 addr) (Word8Array.array len (Word8.fromInt 0))
            val out = Word8Array.array len (Word8.fromInt 0)
        in
        #(mem_read) "" buf;
        Word8Array.copy buf Bytes.size_of_uint64_buf len out 0;
        out
        end

    (* Read 32 bits from memory *)
    fun mem_read32 (addr : int) =
        let
            val buf = Bytes.buf_of_uint64 addr
        in
        #(mem_read32) "" buf;
        Bytes.uint64_of_buf buf
        end

    (* Read 64 bits from memory *)
    fun mem_read64 (addr : int) =
        let
            val buf = Bytes.buf_of_uint64 addr
        in
        #(mem_read64) "" buf;
        Bytes.uint64_of_buf buf
        end

    (* Write the bytes of [data] to memory address [addr] *)
    fun mem_write (addr : int) (data : byte_array) =
        #(mem_write) "" (Bytes.append_w8 (Bytes.buf_of_uint64 addr) data)

    (* Write the low 32 bits of [value] to memory address [addr] *)
    fun mem_write32 (addr : int) (value : int) =
        #(mem_write32) "" (Bytes.append_w8 (Bytes.buf_of_uint64 addr) (Bytes.buf_of_uint64 value))

    (* Write [value], modulo 2^64, to memory address [addr] *)
    fun mem_write64 (addr : int) (value : int) =
        #(mem_write64) "" (Bytes.append_w8 (Bytes.buf_of_uint64 addr) (Bytes.buf_of_uint64 value))

    (* Read [len] bytes from physical memory address [addr] *)
    fun pmem_read (addr : int) = mem_read (hhdm_off + addr)

    (* Read 32 bits from physical memory address [addr] *)
    fun pmem_read32 (addr : int) = mem_read32 (hhdm_off + addr)

    (* Read 64 bits from physical memory address [addr] *)
    fun pmem_read64 (addr : int) = mem_read64 (hhdm_off + addr)

    (* Write the bytes of [data] to physical memory address [addr] *)
    fun pmem_write (addr : int) = mem_write (hhdm_off + addr)

    (* Write the low 32 bits of [value] to physical memory address [addr] *)
    fun pmem_write32 (addr : int) = mem_write32 (hhdm_off + addr)

    (* Write [value], modulo 2^64, to physical memory address [addr] *)
    fun pmem_write64 (addr : int) = mem_write64 (hhdm_off + addr)
end
