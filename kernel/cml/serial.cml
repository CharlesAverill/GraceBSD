(* UART I/O functions *)
structure Serial = struct
    (* Write a string to COM1 *)
    fun write (s : string) =
        #(serial_write) s Bytes.empty_buf

    (* Read n bytes from COM1, stop on newline or CR *)
    fun readn (n : int) =
        let
            val buf = Word8Array.array (Bytes.size_of_uint64_buf + n) (Word8.fromInt 0)
        in
            #(serial_readn) "" buf;
            Word8Array.substring buf Bytes.size_of_uint64_buf (Bytes.uint64_of_buf buf)
        end

    (* Wait for one character from COM1, without echoing it *)
    fun read_char () =
        let
            val buf = Word8Array.array 1 (Word8.fromInt 0)
        in
        #(serial_read_char) "" buf;
        Char.chr (Word8.toInt (Word8Array.sub buf 0))
        end

    (* Write a string to COM1 and print a newline *)
    fun writeln (s : string) =
        #(serial_write) (s ^ "\n") Bytes.empty_buf

    (* Clamp a CakeML unbounded int to a signed 64-bit integer and write it in
       decimal to the COM1 *)
    fun write_int (n : int) =
        #(serial_write_int) "" (Bytes.buf_of_int64 n)

    (* Write n in hexadecimal to COM1 as an unsigned 64-bit integer *)
    fun write_hex (n : int) =
        #(serial_write_hex) "" (Bytes.buf_of_uint64 n)
end
