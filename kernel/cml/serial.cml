val empty_buf = Word8Array.array 0 (Word8.fromInt 0)

fun buf_of_int_list (l : int list) =
    let
      val arr = Word8Array.array (List.length l) (Word8.fromInt 0)
      fun fill i xs =
        case xs of
          [] => arr
        | x :: rest => (Word8Array.update arr i (Word8.fromInt x); fill (i + 1) rest)
    in
      fill 0 l
    end

val int64_max = 9223372036854775807
val int64_min = ~9223372036854775808

fun clamp_int64 (n : int) =
    if n > int64_max then int64_max
    else if n < int64_min then int64_min
    else n

val size_of_int64_buf = 8

(* Clamp and encode n as 8 bytes of little-endian two's complement *)
fun buf_of_int64 (n : int) =
    let
      val arr = Word8Array.array size_of_int64_buf (Word8.fromInt 0)
      fun fill i v =
        if i = size_of_int64_buf then arr
        else (Word8Array.update arr i (Word8.fromInt (v mod 256)); fill (i + 1) (v div 256))
    in
      fill 0 (clamp_int64 n)
    end

(* UART I/O functions *)
structure Serial = struct
    (* Write a string to COM1 *)
    fun write (s : string) =
        #(serial_write) s empty_buf

    (* Read n bytes from COM1, stop on newline or CR *)
    fun readn (n : int) =
        let
            val lenbuf = buf_of_int64 n
            val buf = Word8Array.array (size_of_int64_buf + n) (Word8.fromInt 0)
        in
            Word8Array.copy lenbuf 0 size_of_int64_buf buf 0;
            #(serial_readn) "" buf;
            Word8Array.substring buf size_of_int64_buf n
        end

    (* Write a string to COM1 and print a newline *)
    fun writeln (s : string) =
        #(serial_write) (s ^ "\n") empty_buf

    (* Clamp a CakeML unbounded int to a signed 64-bit integer and write it in
       decimal to the COM1 *)
    fun write_int (n : int) =
        #(serial_write_int) "" (buf_of_int64 n)
end
