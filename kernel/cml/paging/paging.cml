(* Architecture-agnostic page tables *)
structure Paging = struct
    val levels = PTE.levels
    val entries_per_table = PTE.entries_per_table
    val page_size = FrameAllocator.page_size

    (* Bytes of address space covered by one entry at [level] *)
    fun entry_span (level : int) = page_size * Bytes.int_pow entries_per_table (level - 1)

    (* Index into the [level] table that translates [vaddr] *)
    fun index_of (vaddr : int) (level : int) = vaddr div entry_span level mod entries_per_table

    (* Present, writable, user, executable, global, accessed, dirty, leaf, address *)
    datatype entry =
        Entry bool bool bool bool bool
              bool bool bool
              int

    fun present    (Entry p _ _ _ _ _ _ _ _)    = p
    fun writable   (Entry _ w _ _ _ _ _ _ _)    = w
    fun user       (Entry _ _ u _ _ _ _ _ _)    = u
    fun executable (Entry _ _ _ x _ _ _ _ _)    = x
    fun global     (Entry _ _ _ _ g _ _ _ _)    = g
    fun accessed   (Entry _ _ _ _ _ a _ _ _)    = a
    fun dirty      (Entry _ _ _ _ _ _ d _ _)    = d
    fun leaf       (Entry _ _ _ _ _ _ _ l _)    = l
    fun address    (Entry _ _ _ _ _ _ _ _ addr) = addr

    val empty = Entry False False False False False False False False 0

    (* Bit 7 means "huge page" only above level 1. At level 1 it is PAT, and every
       present entry is a leaf. In a huge-page entry, bit 12 is PAT rather than
       part of the address, so the address is rounded down to the page size *)
    fun entry_of_pte (level : int) (e : PTE.t) =
        let
            val is_leaf = PTE.present e andalso (level = 1 orelse PTE.ps e)
            val addr = if is_leaf then PTE.next e - PTE.next e mod entry_span level else PTE.next e
        in
            Entry (PTE.present e) (PTE.rw e) (PTE.us e) (not (PTE.nx e)) (PTE.g e)
                  (PTE.a e) (PTE.d e) is_leaf addr
        end

    fun pte_of_entry (level : int) (e : entry) =
        if leaf e andalso level >= levels then
            Log.fatal Log.Rc_Error ("Paging: no leaf entries at level " ^ Int.toString level)
        else if leaf e andalso address e mod entry_span level <> 0 then
            Log.fatal Log.Rc_Error ("Paging: leaf address not aligned to its level: " ^ Hex.hex_str_of_int (address e))
        else
            PTE.MakePTE (present e) (writable e) (user e) False False
                        (accessed e) (dirty e) (leaf e andalso level > 1) (global e)
                        (not (executable e))
                        (address e)

    (* Read entry [index] of the [level] table at physical address [table] *)
    fun read_entry (table : int) (level : int) (index : int) =
        entry_of_pte level (PTE.pte_of_int (Hw.pmem_read64 (table + index * PTE.entry_size)))

    (* Write entry [index] of the [level] table to physical address [table] *)
    fun write_entry (table : int) (level : int) (index : int) (e : entry) =
        Hw.pmem_write64 (table + index * PTE.entry_size) (PTE.int_of_pte (pte_of_entry level e))

    (* Translate [vaddr] through the tables rooted at [root] into its physical
       address, its leaf entry, and the size of the page it lies in. Stop early
       at level [stop]
       
       https://github.com/mit-pdos/xv6-riscv/blob/4f2fc8b7bd47d737b1d9ac9e68e407fc7cdd1cad/kernel/vm.c#L86 *)
    fun walk_step (table : int) (level : int) (vaddr : int) =
        let
            val e = read_entry table level (index_of vaddr level)
        in
        (e, level - 1, address e + vaddr mod entry_span level, entry_span level)
        end

    fun walk_stop (stop : int) (root : int) (vaddr : int) =
        let
            fun aux (table : int) (level : int) =
                let
                    val (e, level', paddr, size) = walk_step table level vaddr
                in
                if not (present e) then None
                else if leaf e orelse stop = level then Some (paddr, e, size)
                else aux (address e) (level - 1)
                end
        in
            aux root levels
        end

    fun walk (root : int) (vaddr : int) = walk_stop 1 root vaddr
end
