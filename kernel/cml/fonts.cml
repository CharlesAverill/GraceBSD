(* Corresponds with fonts.h *)
structure Font = struct
    datatype font = TS_8x8 | TS_8x14 | TS_8x16

    fun int_of_font (f : font) =
        case f of
          TS_8x8 => 0
        | TS_8x14 => 1
        | TS_8x16 => 2

    fun width_of_font (f : font) = Bytes.call_field (fn b => #(width_of_font) "" b) (int_of_font f)

    fun height_of_font (f : font) = Bytes.call_field (fn b => #(height_of_font) "" b) (int_of_font f)

    fun render_glyph (f : font) (c : char) (x : int) (y : int) =
        #(render_glyph) "" (Bytes.buf_of_fields [int_of_font f, Char.ord c, x, y] 4)
end
